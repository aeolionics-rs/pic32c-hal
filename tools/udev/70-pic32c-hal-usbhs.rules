#
# 1209:000B (pid.codes' test range), the USB HS bench programs' device:
# its tty to plugdev, autosuspend after 2 s, and remote wakeup. Copy to
# /etc/udev/rules.d/, then `udevadm control --reload` and replug.

SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="000b", GROUP="plugdev", MODE="0660"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1209", ATTR{idProduct}=="000b", TEST=="power/control", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="2000", ATTR{power/wakeup}="enabled"
